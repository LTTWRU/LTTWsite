# Настройки сервера для сайта церкви «Свет миру».
# Файл читается Apache автоматически, ничего включать не нужно.
# Начинается с точки, поэтому в файловом менеджере может быть скрыт —
# включите показ скрытых файлов, чтобы его увидеть.

# ── Страница ошибки ──────────────────────────────────────────────────
# Вместо английской заглушки Apache показываем нашу оформленную страницу.
ErrorDocument 404 /404.html

# ── Один адрес вместо двух ───────────────────────────────────────────
<IfModule mod_rewrite.c>
  RewriteEngine On

  # www.lttw.ru → lttw.ru
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

  # http → https. Вторая проверка нужна, если сертификат обрывается на
  # балансировщике: без неё редирект зациклится.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
</IfModule>

# ── Кодировка и типы файлов ──────────────────────────────────────────
AddDefaultCharset UTF-8

<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType image/svg+xml .svg
  AddType image/webp .webp
  AddType application/manifest+json .webmanifest
</IfModule>

# ── Сжатие ───────────────────────────────────────────────────────────
# Шрифты и картинки уже сжаты, их повторно жать бессмысленно.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml application/manifest+json
</IfModule>

# ── Кэш браузера ─────────────────────────────────────────────────────
# Страницы держим недолго: правки должны доезжать быстро.
# Стили, скрипты, шрифты и картинки — надолго, они меняются редко.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault                        "access plus 1 hour"
  ExpiresByType text/html               "access plus 10 minutes"
  ExpiresByType text/css                "access plus 6 months"
  ExpiresByType application/javascript  "access plus 6 months"
  ExpiresByType font/woff2              "access plus 1 year"
  ExpiresByType image/png               "access plus 6 months"
  ExpiresByType image/jpeg              "access plus 6 months"
  ExpiresByType image/webp              "access plus 6 months"
  ExpiresByType image/svg+xml           "access plus 6 months"
</IfModule>

# ── Мелочи безопасности ──────────────────────────────────────────────
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"

  # Чужие сайты не смогут показать наш внутри своей рамки и выдать за свой.
  Header set X-Frame-Options "SAMEORIGIN"

  # Камера, микрофон и геолокация сайту не нужны — закрываем заранее.
  Header set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"

  # Браузер запоминает на год, что сюда ходят только по https, и больше
  # не пробует незашифрованное соединение даже по прямой ссылке.
  Header always set Strict-Transport-Security "max-age=31536000"

  # Откуда странице разрешено брать содержимое. Всё своё, кроме двух
  # исключений: карта приходит рамкой с Яндекса после нажатия кнопки,
  # а mc.yandex.ru прописан заранее — чтобы счётчик Метрики заработал
  # сразу, как только номер впишут в site.config.json, и не пришлось
  # править этот файл. 'unsafe-inline' нужен для стилей прямо в вёрстке
  # и для скрипта темы, который срабатывает до первой отрисовки.
  Header set Content-Security-Policy "default-src 'self'; img-src 'self' data: https://mc.yandex.ru; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self' 'unsafe-inline' https://mc.yandex.ru; connect-src 'self' https://mc.yandex.ru; frame-src https://yandex.ru https://*.yandex.ru https://mc.yandex.ru; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
</IfModule>

# Список файлов в папке без index.html показывать не нужно
Options -Indexes
